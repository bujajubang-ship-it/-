YOUTUBE_API_KEY=여기에_유튜브_API_키_입력
ANTHROPIC_API_KEY=여기에_클로드_API_키_입력
OPENAI_API_KEY=여기에_OpenAI_API_키_입력

# 콘텐츠 전략가 (기본 GPT, 실패 시 기존 Claude fallback)
STRATEGY_BRAIN_PROVIDER=openai
STRATEGY_BRAIN_FALLBACK_PROVIDER=anthropic
OPENAI_MODEL=gpt-5.6-sol
OPENAI_REASONING_EFFORT=max
OPENAI_STORE_RESPONSES=false
OPENAI_MAX_TOOL_ROUNDS=8

# YouTube OAuth / 자동 성과 축적
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
OAUTH_REFRESH_TOKEN=
MY_CHANNEL_ID=
YT_AUTO_SYNC_ENABLED=false
YT_AUTO_SYNC_INTERVAL_SECONDS=21600
YT_COLLECTION_MAX_VIDEOS=1000
YT_DAILY_LOOKBACK_DAYS=45
YT_RETENTION_PER_RUN=20
YT_REPORTING_AUTO_CREATE=true

# DB는 명시적으로 바꾸기 전까지 항상 SQLite입니다.
DB_BACKEND=sqlite
# DB_PATH=/절대경로/history.db
# DATABASE_URL은 이번 release에서 사용하지 않습니다.
# 이 release는 PostgreSQL을 포함하지 않습니다.
# Render에서는 DB_PATH=/data/history.db만 허용하며 기존 파일이 없으면 기동을 중단합니다.

# AI 편집 디렉터 저장 정책 (Render에서는 기본 /data/edit_projects)
# EDIT_PROJECT_ROOT=/data/edit_projects
EDIT_STORAGE_BACKEND=local
EDIT_MAX_UPLOAD_MB=2048
EDIT_DISK_RESERVE_MB=128
EDIT_SOURCE_RETENTION_HOURS=72
EDIT_OUTPUT_RETENTION_HOURS=720
EDIT_FAILED_RETENTION_HOURS=72
EDIT_ORPHAN_RETENTION_HOURS=24
EDIT_TEMP_RETENTION_HOURS=1
EDIT_CLEANUP_INTERVAL_SECONDS=3600
EDIT_FFMPEG_THREADS=1
EDIT_OUTPUT_ESTIMATE_RATIO=1.0
EDIT_SHORT_ESTIMATE_RATIO=0.20

# Cloudflare R2 / S3 호환 저장소 전환용 (local일 때는 전혀 사용하지 않음)
# EDIT_STORAGE_BACKEND=object
# EDIT_OBJECT_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# EDIT_OBJECT_BUCKET=
# EDIT_OBJECT_REGION=auto
# EDIT_OBJECT_PREFIX=edit-projects
# EDIT_OBJECT_ACCESS_KEY_ID=
# EDIT_OBJECT_SECRET_ACCESS_KEY=

# Owner 인증 (production에서는 모두 필수)
# AUTH_MODE=owner
# OWNER_USERNAME=
# OWNER_PASSWORD_HASH=
# AUTH_SIGNING_SECRET=
# AUTH_ALLOWED_ORIGINS=https://youtube-researcher.onrender.com
# AUTH_COOKIE_NAME=yt_owner_session
# AUTH_SESSION_TTL_SECONDS=43200
# AUTH_LOGIN_MAX_FAILURES=5
# AUTH_LOGIN_WINDOW_SECONDS=900

# 인증 없이 호출되는 pipeline-remind 전용 machine credential
# PIPELINE_REMIND_SECRET=
# PIPELINE_REMIND_PHONE=

# 기존 CNMaker 연동 (사용 중인 경우에만 설정)
# CNMAKER_BASE=
# CNMAKER_SECRET=

# transcript-debug는 기본 비활성입니다. production에서는 이 값과 무관하게 비활성입니다.
# ENABLE_TRANSCRIPT_DEBUG=false

# 네이버 카페 분석 (선택사항 - 없으면 유튜브만 분석)
NAVER_CLIENT_ID=여기에_네이버_클라이언트_ID
NAVER_CLIENT_SECRET=여기에_네이버_클라이언트_시크릿
